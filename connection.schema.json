{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "database": {
      "title": "Database",
      "type": "string",
      "minLength": 1
    },
    "username": {
      "title": "Username",
      "type": "string",
      "minLength": 1
    },
    "usePassword": {
      "title": "Use password",
      "type": "string",
      "enum": [
        "Ask on connect",
        "Use empty password",
        "Save password"
      ],
      "default": "Ask on connect"
    },
    "password": {
      "title": "Password",
      "type": "string",
      "minLength": 1
    },
    "connectString": {
      "title": "connectString",
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "connectionInitSql": {
      "title": "Connection initialization SQL",
      "type": "string",
      "default": "",
      "description": "SQL statements executed in order when a session is opened, including reconnects and grid-edit sessions. Separate SQL statements with semicolons; terminate PL/SQL blocks with / on a separate line. A failure stops initialization and rejects the connection."
    },
    "connectionMethod": {
      "title": "Connect using",
      "type": "string",
      "minLength": 1,
      "enum": [
        "Server and Port",
        "Connection String"
      ],
      "default": "Server and Port"
    },
    "oracleOptions": {
      "title": "Oracle driver specific options",
      "type": "object",
      "properties": {
        "expireTime": {
          "type": "integer",
          "minimum": 0,
          "default": 10,
          "title": "TCP keep-alive interval (minutes, Thin mode)",
          "description": "Probe idle network connections to reduce firewall idle disconnects. Set 0 to disable. Thick mode requires EXPIRE_TIME in the connection string or Oracle Net configuration."
        },
        "autoCommit": {
            "type": "boolean",
            "default": false,
            "title": "autoCommit"
        },
        "lowerCase": {
            "type": "boolean",
            "default": false,
            "title": "lowerCase for completion"
        },
        "thickMode": {
          "type": "boolean",
          "default": false,
          "title": "use thick mode"
        },
        "limitPrefetchRows": {
          "type": "boolean",
          "default": false,
          "title": "limit prefetch rows"
        }
      }
    }
  },
  "dependencies": {
    "connectionMethod": {
      "oneOf": [
        {
          "properties": {
            "connectionMethod": {
              "enum": [
                "Server and Port"
              ]
            },
            "server": {
              "title": "Server Address",
              "type": "string",
              "minLength": 1,
              "default": "localhost"
            },
            "port": {
              "title": "Port",
              "minimum": 1,
              "default": 1521,
              "type": "integer"
            },
            "database": {
              "$ref": "#/definitions/database"
           },
            "username": {
              "$ref": "#/definitions/username"
            },
            "usePassword": {
              "$ref": "#/definitions/usePassword"
            }
          },
          "required": [
            "database",
            "username"
          ]
        },
        {
          "properties": {
            "connectionMethod": {
              "enum": [
                "Connection String"
              ]
            },
            "username": {
              "$ref": "#/definitions/username"
            },
            "usePassword": {
              "$ref": "#/definitions/usePassword"
            },
            "connectString": {
              "title": "Connection String",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "username",
            "connectString"
          ]
        }
      ]
    },
    "usePassword": {
      "oneOf": [
        {
          "properties": {
            "usePassword": {
              "enum": [
                "Ask on connect"
              ]
            },
            "askForPassword": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "properties": {
            "usePassword": {
              "enum": [
                "Use empty password"
              ]
            }
          }
        },
        {
          "properties": {
            "usePassword": {
              "enum": [
                "Save password"
              ]
            },
            "password": {
              "$ref": "#/definitions/password"
            }
          },
          "required": [
            "password"
          ]
        }
      ]
    }
  },
  "required": [
    "connectionMethod"
  ]
}
